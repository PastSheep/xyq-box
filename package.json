{
  "name": "xyq-box",
  "version": "0.1.0",
  "private": true,
  "description": "一个「一切皆插件」的独立应用 —— TypeScript + Cordis 4 monorepo（M0 仓库脚手架）",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "xyq": "pnpm --filter @xyq-box/xyq run cli",
    "dev": "pnpm --filter @xyq-box/plugin-shell-web dev"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.8"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
